PROJECT_NAME           = "MorphologicalAttributeFilters"
PROJECT_BRIEF          = "Public API documentation"
OUTPUT_DIRECTORY       = "@MMCFILTERS_DOCS_PUBLIC_DIR@"

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/README.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/examples/README.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/notebooks/README.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mmcfilters"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"

RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.tpp *.md
# Implementation-heavy headers installed for template support are documented
# only by the internal Doxygen target.
EXCLUDE                = "@CMAKE_CURRENT_SOURCE_DIR@/mmcfilters/dataStructure" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mmcfilters/trees/BuilderMorphologicalTreeByUnionFind.hpp" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mmcfilters/trees/adjust/DualMinMaxTreeIncrementalFilterLeaf.hpp" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mmcfilters/trees/sdrt"
EXCLUDE_PATTERNS       = */detail/* */internal/*
EXCLUDE_SYMBOLS        = mmcfilters::detail::* \
                         mmcfilters::attributes::computers::detail::* \
                         std::*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
INTERNAL_DOCS          = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@MMCFILTERS_DOCS_PUBLIC_WARN_LOG@"
QUIET                  = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
