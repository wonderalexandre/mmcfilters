PROJECT_NAME           = "MorphologicalAttributeFilters"
PROJECT_BRIEF          = "Internal contributor documentation"
OUTPUT_DIRECTORY       = "@MMCFILTERS_DOCS_INTERNAL_DIR@"

INPUT                  = "@MMCFILTERS_DOCS_SOURCE_DIR@/README.md" \
                         "@MMCFILTERS_DOCS_SOURCE_DIR@/docs" \
                         "@MMCFILTERS_DOCS_SOURCE_DIR@/mmcfilters" \
                         "@MMCFILTERS_DOCS_SOURCE_DIR@/pybinds" \
                         "@MMCFILTERS_DOCS_SOURCE_DIR@/examples" \
                         "@MMCFILTERS_DOCS_SOURCE_DIR@/benchmarks" \
                         "@MMCFILTERS_DOCS_SOURCE_DIR@/unit-tests"
USE_MDFILE_AS_MAINPAGE = "@MMCFILTERS_DOCS_SOURCE_DIR@/README.md"

RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.tpp *.cpp *.md

# Keep extraction selective so WARN_IF_UNDOCUMENTED remains effective. Doxygen
# disables undocumented-symbol warnings when EXTRACT_ALL is enabled.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
INTERNAL_DOCS          = YES
ENABLED_SECTIONS       = INTERNAL
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
USE_MATHJAX            = YES
EXTRA_PACKAGES         = amssymb
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@MMCFILTERS_DOCS_SOURCE_DIR@"

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@MMCFILTERS_DOCS_INTERNAL_WARN_LOG@"
QUIET                  = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
